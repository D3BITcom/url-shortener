// Database schema. After editing, create a migration with:
//   pnpm db:migrate --name <describe-the-change>
// The schema avoids database-specific features, so switching to Postgres is
// a change of `provider` plus a fresh baseline migration (see CONTRIBUTING.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model ShortUrl {
  id        String   @id @default(cuid())
  code      String   @unique
  targetUrl String
  createdAt DateTime @default(now())
  clicks    Click[]

  @@index([targetUrl]) // reuse an existing link for the same URL
  @@index([createdAt]) // newest-first listing
}

// One row per redirect (an event log), so new breakdowns are new queries
// rather than schema changes. Raw IPs are deliberately never stored.
model Click {
  id           String   @id @default(cuid())
  shortUrlId   String
  shortUrl     ShortUrl @relation(fields: [shortUrlId], references: [id], onDelete: Cascade)
  occurredAt   DateTime @default(now())
  /// UTC "YYYY-MM-DD": makes per-day charts a plain GROUP BY on any database.
  day          String
  /// ISO 3166-1 alpha-2, null when unknown.
  country      String?
  browser      String?
  os           String?
  /// desktop | mobile | tablet | other (a string rather than an enum, for portability).
  device       String
  referrerHost String?
  /// Daily-rotating salted hash of IP + User-Agent.
  visitorId    String
  isBot        Boolean  @default(false)

  @@index([shortUrlId, isBot, day])
  @@index([shortUrlId, occurredAt])
}
