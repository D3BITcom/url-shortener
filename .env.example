# Application
NODE_ENV=development
# Port for both `pnpm dev` and `pnpm start` (Docker maps it to the host).
PORT=3000

# Origin that short links are built from: <PUBLIC_URL>/r/<code>.
PUBLIC_URL=http://localhost:3000

# Database (SQLite through Prisma). Relative paths resolve from the package
# directory; all packages sit two levels below the repo root
# (applications/*, libs/*), so this points at <repo>/data/app.db for both
# the web server and the Prisma CLI.
DATABASE_URL=file:../../data/app.db

# Secret mixed into the daily visitor hash (unique-visitor counts).
# This value is for local development only. Anywhere public, generate one
# with: openssl rand -hex 32
ANALYTICS_SALT=local-dev-only-salt-not-secret

# Signs the owner/admin cookies. Local value only; generate a real one anywhere public.
COOKIE_SECRET=local-dev-only-cookie-secret

# Admin console at /r/admin (log in with this token). Remove to disable it.
ADMIN_TOKEN=local-dev-admin-token

# Optional Cloudflare Turnstile ("are you human") on link creation. Leave
# empty to disable. Cloudflare's test keys always pass:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Set to true ONLY when running behind a reverse proxy (nginx) that sets
# X-Forwarded-For. Otherwise clients could spoof their IP with that header.
TRUST_PROXY=false

# Optional: path to an IP-to-country .mmdb database (DB-IP Lite or MaxMind
# GeoLite2). Without it, countries show as "Unknown".
# `pnpm geoip:download` fetches DB-IP Lite to this path.
GEOIP_DB_PATH=../../data/dbip-country-lite.mmdb

# Link creation limit per client IP.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60
