# Lives on the VPS next to docker-compose.prod.yml (default ~/url-shortener/.env).
# Never commit the real file.
PUBLIC_URL=https://d3b.it
ANALYTICS_SALT=generate-with-openssl-rand-hex-32
COOKIE_SECRET=generate-with-openssl-rand-hex-32
ADMIN_TOKEN=generate-with-openssl-rand-hex-24
# Optional Cloudflare Turnstile on link creation (both or neither).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Host port on 127.0.0.1 that nginx proxies to (pick a free one).
HOST_PORT=3000
LOG_LEVEL=info
